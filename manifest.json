{
  "manifest_version": 3,
  "name": "YouTube Toolbox",
  "version": "1.0.0",
  "description": "Hide Shorts, study with fewer distractions, find watched videos, and clean subscriptions and Watch Later.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "YouTube Toolbox",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}